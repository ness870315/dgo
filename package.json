{
  "name": "xtrend-monorepo",
  "version": "1.0.0",
  "description": "DeGen Oracle - Solana Meme Coin Discovery Platform",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm run install:frontend && npm run install:backend",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && npm install",
    "postinstall": "npm run install:backend",
    "start": "cd backend && npm start",
    "start:frontend": "cd frontend && npm start",
    "start:backend": "cd backend && npm start",
    "dev:frontend": "cd frontend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "start:all": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "solana",
    "tokens",
    "blockchain",
    "meme-coins",
    "defi"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@payai/x402-solana": "^0.1.0-beta.2",
    "@raydium-io/raydium-sdk": "^1.3.1-beta.58",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.87.6",
    "apify-client": "^2.16.0",
    "axios": "^1.12.2",
    "bs58": "^6.0.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "esbuild": "^0.17.19",
    "express": "^4.18.2",
    "lilconfig": "^3.1.3",
    "jsdom": "^22.1.0",
    "multer": "^2.0.2",
    "openai": "^4.28.0",
    "protobufjs": "^7.5.4",
    "sentiment": "^5.0.2",
    "sharp": "^0.33.0",
    "tr46": "^5.1.1",
    "webidl-conversions": "^7.0.0",
    "whatwg-url": "^14.2.0",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0",
    "ws": "^8.18.3"
  }
}
