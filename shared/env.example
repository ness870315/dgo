# Alternative Data Sources - No API keys required!
# Twitter API Configuration (OPTIONAL - not needed with alternative data)
# REACT_APP_TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Solana Configuration
REACT_APP_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
REACT_APP_SOLANA_NETWORK=mainnet-beta

# API Configuration - Backend with alternative data sources
REACT_APP_API_BASE_URL=http://localhost:4000
REACT_APP_REFRESH_INTERVAL=300000

# Feature Flags
REACT_APP_ENABLE_REAL_TIME_UPDATES=true
REACT_APP_ENABLE_SENTIMENT_ANALYSIS=true
REACT_APP_ENABLE_RISK_DETECTION=true
